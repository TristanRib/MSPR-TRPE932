{
  "displayName": "Cloud Run WARNING logs",
  "conditions": [
    {
      "displayName": "WARNING log entries Cloud Run",
      "conditionMatchedLog": {
        "filter": "resource.type=(\"cloud_run_job\" OR \"cloud_run_revision\") AND severity=\"WARNING\""
      }
    }
  ],
  "alertStrategy": {
    "notificationRateLimit": {
      "period": "300s"
    }
  },
  "notificationChannels": ["CHANNEL_PLACEHOLDER"],
  "combiner": "OR",
  "enabled": true
}
